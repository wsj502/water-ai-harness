{
  "name": "water-ai-harness",
  "version": "0.4.0",
  "private": true,
  "description": "Water —— 一个用于学习研究的 AI Agent Harness：内核 + CLI + Web + 桌面端 + 插件系统",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev-chat.ts",
    "dev:server": "set WATER_PLUGIN_DIRS=%CD%\\plugins&& tsx watch apps/server/src/index.ts",
    "start:server": "set WATER_PLUGIN_DIRS=%CD%\\plugins&& node apps/server/dist/index.js",
    "typecheck": "tsc --noEmit -p packages/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e-model-switch.ts",
    "build": "tsc -b packages/core apps/server apps/cli && npm run build -w apps/web"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
